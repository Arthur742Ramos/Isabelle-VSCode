{
  "name": "isabelle-pide-vscode",
  "displayName": "Isabelle PIDE",
  "description": "A VS Code frontend foundation for Isabelle/PIDE with a Scala bridge backend.",
  "version": "0.1.0",
  "publisher": "arthur742ramos",
  "private": true,
  "preview": true,
  "qna": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arthur742Ramos/Isabelle-VSCode.git"
  },
  "bugs": {
    "url": "https://github.com/Arthur742Ramos/Isabelle-VSCode/issues"
  },
  "homepage": "https://github.com/Arthur742Ramos/Isabelle-VSCode#readme",
  "keywords": [
    "isabelle",
    "pide",
    "proof-assistant",
    "theorem-proving",
    "vscode"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:isabelle",
    "onCommand:isabelle.showVersion",
    "onCommand:isabelle.checkBackendHealth",
    "onCommand:isabelle.discoverSessions",
    "onCommand:isabelle.refreshSessions",
    "onCommand:isabelle.selectSession",
    "onCommand:isabelle.openTheory",
    "onCommand:isabelle.buildActiveSession",
    "onCommand:isabelle.cancelBuild",
    "onCommand:isabelle.resyncOpenTheories",
    "onCommand:isabelle.showDocumentStatus",
    "onCommand:isabelle.refreshProofOutline",
    "onCommand:isabelle.refreshProofState",
    "onCommand:isabelle.nextCommand",
    "onCommand:isabelle.previousCommand",
    "onCommand:isabelle.revealCurrentCommand",
    "onCommand:isabelle.showProofActions",
    "onCommand:isabelle.runSledgehammer",
    "onCommand:isabelle.cancelSledgehammer",
    "onCommand:isabelle.insertSledgehammerProof",
    "onCommand:isabelle.replaySledgehammerRun",
    "onCommand:isabelle.clearSledgehammerHistory",
    "onCommand:isabelle.createRepairRequest",
    "onCommand:isabelle.previewRepairPatch",
    "onCommand:isabelle.checkRepairWorkspace",
    "onCommand:isabelle.refreshTheoryGraph",
    "onCommand:isabelle.showTheoryDependents",
    "onCommand:isabelle.toggleTheoryGraphMode",
    "onCommand:isabelle.refreshTheoryOutline",
    "onView:isabelle.sessions",
    "onView:isabelle.proofOutline",
    "onView:isabelle.proofState",
    "onView:isabelle.sledgehammer",
    "onView:isabelle.theoryGraph",
    "onView:isabelle.theoryOutline"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "isabelle",
        "aliases": [
          "Isabelle",
          "isabelle"
        ],
        "extensions": [
          ".thy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "isabelle.showVersion",
        "title": "Isabelle: Show Version"
      },
      {
        "command": "isabelle.checkBackendHealth",
        "title": "Isabelle: Check Backend Health"
      },
      {
        "command": "isabelle.discoverSessions",
        "title": "Isabelle: Discover Sessions"
      },
      {
        "command": "isabelle.refreshSessions",
        "title": "Isabelle: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "isabelle.selectSession",
        "title": "Isabelle: Select Active Session"
      },
      {
        "command": "isabelle.openTheory",
        "title": "Isabelle: Open Theory"
      },
      {
        "command": "isabelle.buildActiveSession",
        "title": "Isabelle: Build Active Session"
      },
      {
        "command": "isabelle.cancelBuild",
        "title": "Isabelle: Cancel Build"
      },
      {
        "command": "isabelle.resyncOpenTheories",
        "title": "Isabelle: Resynchronize Open Theories"
      },
      {
        "command": "isabelle.showDocumentStatus",
        "title": "Isabelle: Show Document Status"
      },
      {
        "command": "isabelle.refreshProofOutline",
        "title": "Isabelle: Refresh Proof Outline",
        "icon": "$(refresh)"
      },
      {
        "command": "isabelle.refreshProofState",
        "title": "Isabelle: Refresh Proof State",
        "icon": "$(refresh)"
      },
      {
        "command": "isabelle.nextCommand",
        "title": "Isabelle: Go to Next Command"
      },
      {
        "command": "isabelle.previousCommand",
        "title": "Isabelle: Go to Previous Command"
      },
      {
        "command": "isabelle.revealCurrentCommand",
        "title": "Isabelle: Reveal Current Command"
      },
      {
        "command": "isabelle.showProofActions",
        "title": "Isabelle: Proof Actions"
      },
      {
        "command": "isabelle.runSledgehammer",
        "title": "Isabelle: Run Sledgehammer",
        "icon": "$(beaker)"
      },
      {
        "command": "isabelle.cancelSledgehammer",
        "title": "Isabelle: Cancel Sledgehammer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "isabelle.insertSledgehammerProof",
        "title": "Isabelle: Insert Sledgehammer Proof",
        "icon": "$(edit)"
      },
      {
        "command": "isabelle.replaySledgehammerRun",
        "title": "Isabelle: Replay Sledgehammer Run"
      },
      {
        "command": "isabelle.clearSledgehammerHistory",
        "title": "Isabelle: Clear Sledgehammer History"
      },
      {
        "command": "isabelle.createRepairRequest",
        "title": "Isabelle: Create Checked Repair Request"
      },
      {
        "command": "isabelle.previewRepairPatch",
        "title": "Isabelle: Preview Repair Patch"
      },
      {
        "command": "isabelle.checkRepairWorkspace",
        "title": "Isabelle: Check Current Workspace for Repair"
      },
      {
        "command": "isabelle.refreshTheoryGraph",
        "title": "Isabelle: Refresh Theory Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "isabelle.showTheoryDependents",
        "title": "Isabelle: Show Theory Dependents"
      },
      {
        "command": "isabelle.toggleTheoryGraphMode",
        "title": "Isabelle: Toggle Theory Graph Direction",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "isabelle.refreshTheoryOutline",
        "title": "Isabelle: Refresh Theory Outline",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "isabelle.sessions",
          "name": "Isabelle Sessions"
        },
        {
          "id": "isabelle.proofOutline",
          "name": "Isabelle Proof Outline"
        },
        {
          "id": "isabelle.proofState",
          "name": "Isabelle Proof State"
        },
        {
          "id": "isabelle.sledgehammer",
          "name": "Isabelle Sledgehammer"
        },
        {
          "id": "isabelle.theoryGraph",
          "name": "Isabelle Theory Graph"
        },
        {
          "id": "isabelle.theoryOutline",
          "name": "Isabelle Theory Outline"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "isabelle.refreshSessions",
          "when": "view == isabelle.sessions",
          "group": "navigation"
        },
        {
          "command": "isabelle.selectSession",
          "when": "view == isabelle.sessions",
          "group": "navigation"
        },
        {
          "command": "isabelle.buildActiveSession",
          "when": "view == isabelle.sessions",
          "group": "navigation"
        },
        {
          "command": "isabelle.refreshProofOutline",
          "when": "view == isabelle.proofOutline",
          "group": "navigation"
        },
        {
          "command": "isabelle.showProofActions",
          "when": "view == isabelle.proofOutline",
          "group": "navigation"
        },
        {
          "command": "isabelle.refreshProofState",
          "when": "view == isabelle.proofState",
          "group": "navigation"
        },
        {
          "command": "isabelle.runSledgehammer",
          "when": "view == isabelle.sledgehammer",
          "group": "navigation"
        },
        {
          "command": "isabelle.cancelSledgehammer",
          "when": "view == isabelle.sledgehammer && isabelle.sledgehammerRunning",
          "group": "navigation"
        },
        {
          "command": "isabelle.insertSledgehammerProof",
          "when": "view == isabelle.sledgehammer && isabelle.sledgehammerHasSuggestion",
          "group": "navigation"
        },
        {
          "command": "isabelle.refreshTheoryGraph",
          "when": "view == isabelle.theoryGraph",
          "group": "navigation"
        },
        {
          "command": "isabelle.toggleTheoryGraphMode",
          "when": "view == isabelle.theoryGraph",
          "group": "navigation"
        },
        {
          "command": "isabelle.refreshTheoryOutline",
          "when": "view == isabelle.theoryOutline",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Isabelle PIDE",
      "properties": {
        "isabelle.backend.command": {
          "type": "string",
          "default": "",
          "description": "Command used to launch the Scala Isabelle VS Code backend. Empty uses ISABELLE_VSCODE_SERVER or isabelle-vscode-server from PATH."
        },
        "isabelle.backend.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to the Scala Isabelle VS Code backend command."
        },
        "isabelle.backend.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for the Scala backend. Empty uses the first workspace folder."
        },
        "isabelle.backend.requestTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "description": "Timeout in milliseconds for backend protocol requests."
        },
        "isabelle.executablePath": {
          "type": "string",
          "default": "isabelle",
          "description": "Path to the Isabelle executable used by the backend for CLI-backed milestone commands."
        },
        "isabelle.session.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional workspace-relative directories to scan for Isabelle ROOT files."
        },
        "isabelle.session.afpPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to an AFP checkout for future session discovery."
        },
        "isabelle.session.active": {
          "type": "string",
          "default": "",
          "description": "Active Isabelle session for the current workspace."
        },
        "isabelle.build.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to `isabelle build` before the active session name."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "vitest run",
    "check": "npm run compile && npm test",
    "package:validate": "npm run check && npm run backend:package && vsce ls --no-dependencies && vsce package --no-dependencies --out isabelle-pide-vscode.validation.vsix && node -e \"require('fs').rmSync('isabelle-pide-vscode.validation.vsix',{force:true})\"",
    "backend:compile": "cd backend && sbt -batch -Dsbt.supershell=false -Dsbt.log.noformat=true compile",
    "backend:package": "cd backend && sbt -batch -Dsbt.supershell=false -Dsbt.log.noformat=true package && cd .. && node -e \"const fs=require('fs');fs.rmSync('backend/dist',{recursive:true,force:true});fs.mkdirSync('backend/dist',{recursive:true});fs.copyFileSync('backend/target/scala-2.13/isabelle-vscode-server.jar','backend/dist/isabelle-vscode-server.jar')\"",
    "backend:run": "cd backend && sbt -batch -Dsbt.supershell=false -Dsbt.log.noformat=true run"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.5.3",
    "vitest": "^4.1.6"
  }
}
