{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Isabelle",
  "scopeName": "source.isabelle",
  "fileTypes": ["thy"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#cartouche" },
    { "include": "#cartouche-ascii" },
    { "include": "#string" },
    { "include": "#antiquotation" },
    { "include": "#method-block" },
    { "include": "#method-bare" },
    { "include": "#proof-dash" },
    { "include": "#keywords-theory" },
    { "include": "#keywords-statement" },
    { "include": "#keywords-context" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-proof" },
    { "include": "#keywords-proof-terminal" },
    { "include": "#keywords-diagnostic" },
    { "include": "#keywords-ml" },
    { "include": "#isabelle-symbol" },
    { "include": "#schematic-variable" },
    { "include": "#type-variable" },
    { "include": "#numeral" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.isabelle",
      "begin": "\\(\\*",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.isabelle" }
      },
      "end": "\\*\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.isabelle" }
      },
      "patterns": [
        { "include": "#comment" }
      ]
    },
    "cartouche": {
      "name": "string.quoted.other.cartouche.isabelle",
      "begin": "\\x{2039}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.cartouche.begin.isabelle" }
      },
      "end": "\\x{203a}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.cartouche.end.isabelle" }
      },
      "patterns": [
        { "include": "#cartouche" },
        { "include": "#cartouche-ascii" },
        { "include": "#antiquotation" },
        { "include": "#isabelle-symbol" }
      ]
    },
    "cartouche-ascii": {
      "name": "string.quoted.other.cartouche.isabelle",
      "begin": "\\\\<open>",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.cartouche.begin.isabelle" }
      },
      "end": "\\\\<close>",
      "endCaptures": {
        "0": { "name": "punctuation.definition.cartouche.end.isabelle" }
      },
      "patterns": [
        { "include": "#cartouche-ascii" },
        { "include": "#cartouche" },
        { "include": "#antiquotation" },
        { "include": "#isabelle-symbol" }
      ]
    },
    "string": {
      "name": "string.quoted.double.isabelle",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.isabelle" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.isabelle" }
      },
      "patterns": [
        { "include": "#antiquotation" },
        { "include": "#isabelle-symbol" },
        { "include": "#schematic-variable" },
        { "include": "#type-variable" }
      ]
    },
    "antiquotation": {
      "name": "meta.antiquotation.isabelle",
      "begin": "(@\\{)\\s*([a-z][a-z0-9_]*)?",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.antiquotation.begin.isabelle" },
        "2": { "name": "keyword.other.antiquotation.isabelle" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.antiquotation.end.isabelle" }
      },
      "patterns": [
        { "include": "#string" },
        { "include": "#isabelle-symbol" },
        { "include": "#schematic-variable" },
        { "include": "#type-variable" }
      ]
    },
    "isabelle-symbol": {
      "name": "constant.character.isabelle-symbol.isabelle",
      "match": "\\\\<\\^?[A-Za-z]+>"
    },
    "type-variable": {
      "name": "storage.type.variable.isabelle",
      "match": "(?<![A-Za-z0-9_'])'[A-Za-z_][A-Za-z0-9_']*"
    },
    "schematic-variable": {
      "name": "variable.other.schematic.isabelle",
      "match": "(?<![A-Za-z0-9_'])\\?[A-Za-z_][A-Za-z0-9_'.]*"
    },
    "numeral": {
      "name": "constant.numeric.isabelle",
      "match": "(?<![A-Za-z0-9_'])[0-9]+(?:\\.[0-9]+)?"
    },
    "proof-methods": {
      "name": "support.function.method.isabelle",
      "match": "(?<![A-Za-z0-9_'.])(?:unfold_locales|rule_format|presburger|raw_tactic|sledgehammer|fastforce|induct_tac|induction|bestsimp|case_tac|clarsimp|rule_tac|simp_all|standard|assumption|linarith|succeed|clarify|algebra|deepen|tactic|meson|metis|blast|force|arith|subst|erule|drule|frule|intro|rules|cases|induct|coinduct|unfold|fold|this|fact|safe|fast|best|slow|auto|simp|elim|rule|smt|fail)(?![A-Za-z0-9_'.])"
    },
    "method-modifier": {
      "name": "entity.other.attribute-name.isabelle",
      "match": "(?<![A-Za-z0-9_'])[a-z][a-zA-Z0-9_']*(?=\\s*:)"
    },
    "method-arguments": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#cartouche" },
        { "include": "#cartouche-ascii" },
        { "include": "#method-modifier" },
        { "include": "#proof-methods" },
        { "include": "#nested-parens" },
        { "include": "#isabelle-symbol" },
        { "include": "#schematic-variable" },
        { "include": "#type-variable" },
        { "include": "#numeral" }
      ]
    },
    "nested-parens": {
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.section.group.begin.isabelle" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.group.end.isabelle" }
      },
      "patterns": [
        { "include": "#method-arguments" }
      ]
    },
    "method-block": {
      "begin": "(?<![A-Za-z0-9_'])(apply|apply_end|by|proof)(?![A-Za-z0-9_'])\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.proof.isabelle" },
        "2": { "name": "punctuation.section.group.begin.isabelle" }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": { "name": "punctuation.section.group.end.isabelle" }
      },
      "patterns": [
        { "include": "#method-arguments" }
      ]
    },
    "method-bare": {
      "match": "(?<![A-Za-z0-9_'])(by|apply|apply_end)(?![A-Za-z0-9_'])(\\s+)([a-z][a-zA-Z0-9_']*)",
      "captures": {
        "1": { "name": "keyword.control.proof.isabelle" },
        "3": { "name": "support.function.method.isabelle" }
      }
    },
    "proof-dash": {
      "match": "(?<![A-Za-z0-9_'])(proof)(?![A-Za-z0-9_'])(\\s+)(-)",
      "captures": {
        "1": { "name": "keyword.control.proof.isabelle" },
        "3": { "name": "keyword.other.null-method.isabelle" }
      }
    },
    "keywords-theory": {
      "name": "keyword.control.theory.isabelle",
      "match": "(?<![A-Za-z0-9_'])(?:subsubsection|subparagraph|subsection|paragraph|text_raw|keywords|abbrevs|chapter|section|imports|theory|begin|text|txt|end)(?![A-Za-z0-9_'])"
    },
    "keywords-statement": {
      "name": "keyword.control.statement.isabelle",
      "match": "(?<![A-Za-z0-9_'])(?:global_interpretation|interpretation|schematic_goal|proposition|termination|corollary|sublocale|subclass|instance|theorem|lemma)(?![A-Za-z0-9_'])"
    },
    "keywords-context": {
      "name": "keyword.control.context.isabelle",
      "match": "(?<![A-Za-z0-9_'])(?:instantiation|overloading|experiment|context|notepad|locale|class)(?![A-Za-z0-9_'])"
    },
    "keywords-declaration": {
      "name": "keyword.other.declaration.isabelle",
      "match": "(?<![A-Za-z0-9_'])(?:typed_print_translation|parse_ast_translation|print_ast_translation|no_adhoc_overloading|syntax_declaration|adhoc_overloading|parse_translation|print_translation|no_type_notation|attribute_setup|coinductive_set|lift_definition|no_translations|axiomatization|named_theorems|code_datatype|external_file|generate_file|inductive_set|realizability|simproc_setup|syntax_consts|type_notation|abbreviation|default_sort|extract_type|method_setup|syntax_types|translations|type_synonym|bibtex_file|coinductive|declaration|local_setup|no_notation|nonterminal|open_bundle|ROOTS_file|codatatype|definition|hide_class|hide_const|type_alias|fun_cases|hide_fact|hide_type|inductive|no_syntax|primcorec|realizers|datatype|function|judgment|notation|theorems|typedecl|unbundle|declare|extract|primrec|typedef|bundle|consts|lemmas|oracle|record|syntax|alias|setup|fun)(?![A-Za-z0-9_'])"
    },
    "keywords-proof": {
      "name": "keyword.control.proof.isabelle",
      "match": "(?<![A-Za-z0-9_'])(?:ultimately|apply_end|including|interpret|unfolding|consider|moreover|finally|include|presume|subgoal|assume|define|obtain|prefer|supply|apply|defer|guess|hence|proof|using|write|also|back|case|from|have|next|note|show|then|thus|with|fix|let)(?![A-Za-z0-9_'])"
    },
    "keywords-proof-terminal": {
      "name": "keyword.control.proof.terminal.isabelle",
      "match": "(?<![A-Za-z0-9_'])(?:sorry|oops|done|qed|by)(?![A-Za-z0-9_'])"
    },
    "keywords-diagnostic": {
      "name": "keyword.other.diagnostic.isabelle",
      "match": "(?<![A-Za-z0-9_'])(?:scala_build_generated_files|compile_generated_files|print_ML_antiquotations|export_generated_files|print_antiquotations|print_term_bindings|print_definitions|print_trans_rules|print_attributes|print_defn_rules|print_codesetup|print_statement|print_commands|print_theorems|find_theorems|print_abbrevs|print_bundles|print_classes|print_context|print_interps|print_locales|print_methods|print_options|print_simpset|print_locale|print_syntax|print_theory|sledgehammer|solve_direct|export_code|find_consts|locale_deps|print_cases|print_facts|print_rules|print_state|thm_oracles|unused_thms|class_deps|quickcheck|full_prf|thm_deps|thy_deps|nitpick|welcome|value|help|prop|term|try0|prf|thm|try|typ)(?![A-Za-z0-9_'])"
    },
    "keywords-ml": {
      "name": "keyword.other.ml.isabelle",
      "match": "(?<![A-Za-z0-9_'])(?:SML_file_no_debug|ML_file_no_debug|SML_file_debug|ML_file_debug|ML_command|SML_export|SML_import|ML_export|SML_file|ML_file|ML_prf|ML_val|ML)(?![A-Za-z0-9_'])"
    }
  }
}
